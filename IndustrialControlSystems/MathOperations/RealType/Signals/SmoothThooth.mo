within IndustrialControlSystems.MathOperations.RealType.Signals;
model SmoothThooth "Obsolete: misspelled name of SmoothTooth, use SmoothTooth instead"
  extends SmoothTooth;
  extends Modelica.Icons.ObsoleteModel;
  annotation (obsolete="Misspelled class name, use IndustrialControlSystems.MathOperations.RealType.Signals.SmoothTooth instead",
    Documentation(info="<html>
<p>This class is obsolete and will be removed in a later version.
It is kept so that models built with version 2.0.0 or earlier still work.
Use <a href=\"modelica://IndustrialControlSystems.MathOperations.RealType.Signals.SmoothTooth\">SmoothTooth</a> instead,
which has the same parameters, connectors and behaviour.</p>
</html>"));
end SmoothThooth;
