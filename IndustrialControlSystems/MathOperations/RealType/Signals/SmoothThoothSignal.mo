within IndustrialControlSystems.MathOperations.RealType.Signals;
model SmoothThoothSignal "Obsolete: misspelled name of SmoothToothSignal, use SmoothToothSignal instead"
  extends SmoothToothSignal;
  extends Modelica.Icons.ObsoleteModel;
  annotation (obsolete="Misspelled class name, use IndustrialControlSystems.MathOperations.RealType.Signals.SmoothToothSignal instead",
    Documentation(info="<html>
<p>This class is obsolete and will be removed in a later version.
It is kept so that models built with version 2.0.0 or earlier still work.
Use <a href=\"modelica://IndustrialControlSystems.MathOperations.RealType.Signals.SmoothToothSignal\">SmoothToothSignal</a> instead,
which has the same parameters, connectors and behaviour.</p>
</html>"));
end SmoothThoothSignal;
