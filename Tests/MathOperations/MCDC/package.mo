within Tests.MathOperations;
package MCDC "MC/DC tests of MathOperations"
  extends Modelica.Icons.ExamplesPackage;
  annotation (Documentation(info="<html>
MC/DC tests of MathOperations. <p>Each class has a <code>Base</code> model (the class under test <code>dut</code> with every option off, its stimuli, an independently stated expectation and checks) and one variant per option change, <code>extends Base(option=...)</code>; classes without options get one scenario model whose run gives every condition of their run-time decisions both values. Every model is self-checking (<code>passed</code>). Generated by <code>Tests/Scripts/generate_mcdc_library.py</code>; edit the generator, not the models. See also <a href=\"modelica://Tests.Controllers.MCDC\">Tests.Controllers.MCDC</a>.</p><p>The IntegerType operators are covered in both branches by Tests.MathOperations.IntegerOperations.</p>
</html>"));
end MCDC;
